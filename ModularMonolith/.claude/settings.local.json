{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet build:*)",
      "Bash(Select-String -Pattern \"\\(Test run|Passed!|Failed!|Total tests:|Starting test\\)\" -Context 0,1)",
      "Bash(git grep:*)",
      "Bash(git ls-tree:*)",
      "Bash(find:*)",
      "Bash(dir:*)",
      "Bash(Select-String -Pattern \"Failed\" -Context 5,10)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(Select-String -Pattern \"\\(Passed|Failed|venue\\)\" -Context 0,1)",
      "Bash(git log:*)",
      "Bash(dotnet sln:*)",
      "Bash(dotnet sln add:*)",
      "Bash(git rev-parse:*)",
      "Bash(chmod:*)",
      "Bash(dotnet dev-certs:*)"
    ],
    "deny": [],
    "ask": []
  }
}
