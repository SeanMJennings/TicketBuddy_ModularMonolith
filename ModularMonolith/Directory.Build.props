<Project>
  <ItemGroup Condition="$(MSBuildProjectName.Contains('Testing'))">
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Include Architecture.Events Analyzer for all Events module projects except the analyzer itself and test projects -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Events')) AND '$(MSBuildProjectName)' != 'Architecture.Events' AND !$(MSBuildProjectName.Contains('Testing'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Modules\Events\Architecture.Events\Architecture.Events.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Include Architecture.Tickets Analyzer for all Tickets module projects except the analyzer itself and test projects -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tickets')) AND '$(MSBuildProjectName)' != 'Architecture.Tickets' AND !$(MSBuildProjectName.Contains('Testing'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Modules\Tickets\Architecture.Tickets\Architecture.Tickets.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>